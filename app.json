{
  "expo": {
    "name": "GameSpot",
    "slug": "gamespot",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gamespot",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-image-picker", "expo-asset"],
    "experiments": { "typedRoutes": true },
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.gamespot.app" },
    "android": { "package": "com.gamespot.app" }
  }
}
